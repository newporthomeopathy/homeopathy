---
interface Breadcrumb {
  name: string
  path: string
}

interface Props {
  items: Breadcrumb[]
}

const { items } = Astro.props
---

{items.length > 0 && (
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <ol>
      {items.map((item, index) => (
        <li>
          {index === items.length - 1 ? (
            <span aria-current="page">{item.name}</span>
          ) : (
            <a href={item.path}>{item.name}</a>
          )}
        </li>
      ))}
    </ol>
  </nav>
)}

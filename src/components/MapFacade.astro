---
import { site } from '../data/site'
---

{site.googleBusinessProfile && (
  <a
    class="map-facade"
    href={site.googleBusinessProfile.url}
    target="_blank"
    rel="noopener"
    aria-label="Open Newport Homeopathy Clinic in Google Maps"
    data-track="click_directions"
  >
    <svg viewBox="0 0 32 32" width="32" height="32" aria-hidden="true">
      <path
        d="M16 29s10-9.2 10-17a10 10 0 1 0-20 0c0 7.8 10 17 10 17Z"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      />
      <circle cx="16" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="2" />
    </svg>
    <span>
      <strong>{site.address.addressLocality}, {site.address.addressRegion}</strong>
      <span>Open Google Maps for directions</span>
    </span>
  </a>
)}
